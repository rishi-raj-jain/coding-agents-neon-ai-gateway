# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# A project-scoped Neon API key for the project below. In the Neon Console, switch to
# your organization, go to Settings > API keys, click Create new, and select
# Project-scoped. The server uses it to mint, rotate, and revoke one AI Gateway
# credential per agent, and it can't reach your other projects.
# https://neon.com/docs/manage/api-keys#create-project-scoped-organization-api-keys
NEON_API_KEY=

# The Neon project whose AI Gateway the agents use (Settings > General in the Neon
# Console). Create it in a region with AI Gateway, such as aws-us-east-2, and add AI
# Gateway credits on the Billing page.
NEON_PROJECT_ID=

# Optional overrides
# NEON_ORG_ID=org-...     only if you use a personal API key instead: the project's organization
# NEON_BRANCH_ID=br-...   anchor the credentials to this branch instead of the default one
# AGENT37_API_BASE=https://api.agent37.com
# AGENT37_APP_DOMAIN=agent37.app
